#!/bin/sh

# Menú de dwm: apagar, reiniciar, bloquear y todas las aplicaciones
# instaladas, sin importar el formato (deb, flatpak, snap, AppImage, etc.).

cache="${XDG_CACHE_HOME:-$HOME/.cache}/dwm-dmenu"
mkdir -p "$cache" 2>/dev/null
map="$cache/apps.map"
list="$cache/apps.list"
data_home="${XDG_DATA_HOME:-$HOME/.local/share}"

# 1. Aplicaciones con archivo .desktop (deb, flatpak, snap, AppImage...).
#    Se leen los directorios de usuario y de sistema, en ese orden.
{
	for dir in \
		"$data_home/applications" \
		"$data_home/flatpak/exports/share/applications" \
		"/var/lib/flatpak/exports/share/applications" \
		"/var/lib/snapd/desktop/applications" \
		"/usr/local/share/applications" \
		"/usr/share/applications"
	do
		[ -d "$dir" ] && find "$dir" -maxdepth 1 \( -type f -o -type l \) -name '*.desktop' -print0 2>/dev/null
	done
} | xargs -0 -r awk '
	function emit() {
		if (type == "Application" && !skip && name != "" && exe != "") {
			n = (name_es != "" ? name_es : name)
			gsub(/\t/, " ", n)
			gsub(/%%/, "\001", exe)
			gsub(/%[fFuUdDnNickvm]/, "", exe)
			gsub("\001", "%", exe)
			gsub(/@@[[:alpha:]]*/, "", exe)
			gsub(/@@/, "", exe)
			print n "\t" (term ? 1 : 0) "\t" exe
		}
	}
	FNR == 1 { emit(); name=""; name_es=""; exe=""; type=""; skip=0; term=0; main=0 }
	/^\[/ { main = ($0 == "[Desktop Entry]"); next }
	main && /^Type=/ { type = substr($0, 6) }
	main && /^Name=/ { name = substr($0, 6) }
	main && /^Name\[es/ { name_es = substr($0, index($0, "=") + 1) }
	main && /^Exec=/ { if (exe == "") exe = substr($0, 6) }
	main && /^(Hidden|NoDisplay)=true/ { skip = 1 }
	main && /^Terminal=true/ { term = 1 }
	END { emit() }
' >"$map.raw"

# Quitar entradas repetidas por nombre visible.
awk -F '\t' 'NF >= 3 && $1 != "" && !seen[$1]++' "$map.raw" >"$map"

# 2. Flatpaks que no exportan archivo .desktop (por ejemplo, herramientas CLI).
if command -v flatpak >/dev/null 2>&1; then
	flatpak list --app --columns=application,name 2>/dev/null |
	while IFS="$(printf '\t')" read -r appid name; do
		[ -n "$appid" ] || continue
		[ -e "/var/lib/flatpak/exports/share/applications/$appid.desktop" ] && continue
		[ -e "$data_home/flatpak/exports/share/applications/$appid.desktop" ] && continue
		printf '%s\t0\tflatpak run %s\n' "$name" "$appid" >>"$map"
	done
fi

# 3. AppImages ejecutables en las carpetas habituales.
for dir in "$HOME/Applications" "$HOME/AppImages" "$HOME/Descargas" "$HOME/.local/bin" "/opt"; do
	[ -d "$dir" ] || continue
	find "$dir" -maxdepth 1 -type f -iname '*.AppImage' -perm -u+x -exec sh -c '
		for img do
			printf "%s\t0\t\"%s\"\n" "$(basename "$img" .AppImage)" "$img"
		done
	' sh {} + >>"$map" 2>/dev/null
done

# Volver a deduplicar tras añadir flatpaks y AppImages.
awk -F '\t' 'NF >= 3 && $1 != "" && !seen[$1]++' "$map" >"$map.dedup" && mv "$map.dedup" "$map"

# 4. Lista final: primero aplicaciones con nombre amigable y luego los
#    ejecutables del PATH (herramientas de terminal incluidas).
cut -f1 "$map" | sort -u >"$list"
{
	cat "$list"
	/usr/local/bin/dmenu_path 2>/dev/null
} | awk '!seen[$0]++' >"$list.all" && mv "$list.all" "$list"

choice=$( {
	printf '%s\n' "Apagar" "Reiniciar" "Bloquear"
	cat "$list"
} | /usr/local/bin/dmenu -i -l 20 -p "Ejecutar:")

[ -n "$choice" ] || exit 0

case "$choice" in
	Apagar)
		systemctl poweroff || loginctl poweroff
		;;
	Reiniciar)
		systemctl reboot || loginctl reboot
		;;
	Bloquear)
		/usr/local/bin/slock
		;;
esac

# Buscar la aplicación en el mapa nombre -> comando.
term=$(CHOICE="$choice" awk -F '\t' '$1 == ENVIRON["CHOICE"] { print $2; exit }' "$map")
cmd=$(CHOICE="$choice" awk -F '\t' '$1 == ENVIRON["CHOICE"] { print $3; exit }' "$map")

if [ -n "$cmd" ]; then
	if [ "$term" = "1" ] && command -v kitty >/dev/null 2>&1; then
		exec kitty -e sh -c "$cmd"
	fi
	exec sh -c "$cmd"
fi

# Si no está en el mapa, es un comando del PATH.
exec "$choice"
