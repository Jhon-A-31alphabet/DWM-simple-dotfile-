#!/usr/bin/env python3
"""Selector TUI del perfil de energía del sistema.

Soporta power-profiles-daemon (PPD) y TLP 1.9 o superior. Detecta
automáticamente cuál está activo y usa la interfaz correspondiente:
powerprofilesctl, tlpctl o tlp (con pkexec/sudo cuando hace falta).
"""

from __future__ import annotations

import curses
import re
import shutil
import subprocess
import sys

APP_NAME = "Bateria"
PROFILES = [
    ("Rendimiento", "performance"),
    ("Equilibrado", "balanced"),
    ("Ahorro de bateria", "power-saver"),
]
PROFILE_KEYS = {key for _, key in PROFILES}


def run_command(args: list[str], timeout: int = 10) -> tuple[int, str, str]:
    try:
        result = subprocess.run(
            args,
            capture_output=True,
            text=True,
            timeout=timeout,
        )
    except (OSError, subprocess.TimeoutExpired) as exc:
        return 1, "", str(exc)
    return result.returncode, result.stdout.strip(), result.stderr.strip()


def service_active(name: str) -> bool:
    if not shutil.which("systemctl"):
        return False
    rc, _, _ = run_command(["systemctl", "is-active", "--quiet", name], timeout=5)
    return rc == 0


def tlp_version() -> tuple[int, int] | None:
    for args in (["tlp-stat", "-s"], ["tlp", "--version"]):
        if not shutil.which(args[0]):
            continue
        _, output, _ = run_command(args, timeout=5)
        match = re.search(r"(?:TLP\s+)?version\s+(\d+)\.(\d+)", output, re.I)
        if not match:
            match = re.search(r"TLP\s+(\d+)\.(\d+)", output, re.I)
        if match:
            return int(match.group(1)), int(match.group(2))
    return None


def get_profile(kind: str) -> str | None:
    if kind == "ppd":
        rc, output, _ = run_command(["powerprofilesctl", "get"])
        return output if rc == 0 and output in PROFILE_KEYS else None
    if kind == "tlpctl":
        rc, output, _ = run_command(["tlpctl", "get"])
        if rc == 0:
            for key in PROFILE_KEYS:
                if re.search(rf"\b{re.escape(key)}\b", output):
                    return key
        return None
    if kind == "tlp":
        # tlp no tiene un "get" de perfil. tlpctl sí, si está disponible.
        if shutil.which("tlpctl"):
            rc, output, _ = run_command(["tlpctl", "get"])
            if rc == 0:
                for key in PROFILE_KEYS:
                    if re.search(rf"\b{re.escape(key)}\b", output):
                        return key
        _, output, _ = run_command(["tlp-stat", "-s"])
        match = re.search(r"Profile:\s*([A-Za-z-]+)", output, re.I)
        if match:
            value = match.group(1).lower()
            if value in PROFILE_KEYS:
                return value
    return None


def detect_backend() -> tuple[str, str, str]:
    """Devuelve (tipo, etiqueta visible, advertencia)."""
    ppd = shutil.which("powerprofilesctl")
    tlpctl = shutil.which("tlpctl")
    tlp = shutil.which("tlp")
    ppd_active = service_active("power-profiles-daemon")
    tlp_active = service_active("tlp") or service_active("tlp-pd")
    warning = ""
    if ppd_active and tlp_active:
        warning = "PPD y TLP están activos a la vez; se usará PPD."

    if ppd and ppd_active:
        return "ppd", "power-profiles-daemon", warning
    if (tlpctl or tlp) and tlp_active:
        if tlpctl and run_command(["tlpctl", "get"])[0] == 0:
            return "tlpctl", "TLP (tlpctl)", warning
        version = tlp_version()
        if version and version >= (1, 9):
            return "tlp", f"TLP {version[0]}.{version[1]}", warning
        return "tlp-old", "TLP 1.8 o anterior", warning

    # Fallback si los servicios no están activos pero los comandos responden.
    if ppd and run_command(["powerprofilesctl", "get"])[0] == 0:
        return "ppd", "power-profiles-daemon", warning
    if tlpctl and run_command(["tlpctl", "get"])[0] == 0:
        return "tlpctl", "TLP (tlpctl)", warning
    if tlp:
        version = tlp_version()
        if version and version >= (1, 9):
            return "tlp", f"TLP {version[0]}.{version[1]}", warning
        return "tlp-old", "TLP 1.8 o anterior", warning
    return "none", "No detectado", warning


def set_profile(kind: str, profile: str, stdscr: curses.window | None = None) -> tuple[bool, str]:
    if kind == "ppd":
        rc, output, error = run_command(["powerprofilesctl", "set", profile])
    elif kind == "tlpctl":
        rc, output, error = run_command(["tlpctl", "set", profile])
    elif kind == "tlp":
        if shutil.which("pkexec"):
            command = ["pkexec", "tlp", profile]
        elif shutil.which("sudo"):
            command = ["sudo", "-n", "tlp", profile]
        else:
            return False, "TLP necesita pkexec o sudo para cambiar de perfil."
        if stdscr is not None:
            curses.endwin()
        try:
            rc, output, error = run_command(command, timeout=120)
        finally:
            if stdscr is not None:
                stdscr.refresh()
    elif kind == "tlp-old":
        return False, "TLP 1.8 no soporta los tres perfiles. Usa TLP 1.9+ o PPD."
    else:
        return False, "No se detectó power-profiles-daemon ni TLP 1.9+."

    if rc != 0:
        detail = error or output
        return False, detail or f"El comando terminó con código {rc}."
    return True, ""


def safe_addstr(stdscr: curses.window, y: int, x: int, text: str, attr: int = 0) -> None:
    try:
        stdscr.addstr(y, x, text, attr)
    except curses.error:
        pass


class BatteryTUI:
    def __init__(self) -> None:
        self.backend, self.backend_label, self.warning = detect_backend()
        self.current = get_profile(self.backend) if self.backend not in {"none", "tlp-old"} else None
        self.selected = self.profile_index(self.current)
        self.message = ""
        self.error = ""
        self.colors = False

        if self.backend == "none":
            self.error = "No se detectó power-profiles-daemon ni TLP 1.9+."
        elif self.backend == "tlp-old":
            self.error = "TLP 1.8 no soporta los tres perfiles. Actualiza a TLP 1.9+."
        elif self.warning:
            self.message = self.warning
        elif self.current is None:
            self.message = "No se pudo leer el perfil actual."

    @staticmethod
    def profile_index(profile: str | None) -> int:
        for index, (_, key) in enumerate(PROFILES):
            if key == profile:
                return index
        return 0

    def initialize_colors(self) -> None:
        if not curses.has_colors():
            return
        try:
            curses.start_color()
            curses.use_default_colors()
            curses.init_pair(1, curses.COLOR_CYAN, -1)
            curses.init_pair(2, curses.COLOR_BLACK, curses.COLOR_CYAN)
            curses.init_pair(3, curses.COLOR_RED, -1)
            self.colors = True
        except curses.error:
            self.colors = False

    def title_attr(self) -> int:
        return curses.color_pair(1) | curses.A_BOLD if self.colors else curses.A_BOLD

    def selected_attr(self) -> int:
        return curses.color_pair(2) | curses.A_BOLD if self.colors else curses.A_REVERSE

    def error_attr(self) -> int:
        return curses.color_pair(3) | curses.A_BOLD if self.colors else curses.A_BOLD

    def apply_selected(self, stdscr: curses.window) -> None:
        if self.backend in {"none", "tlp-old"}:
            return
        label, profile = PROFILES[self.selected]
        ok, detail = set_profile(self.backend, profile, stdscr)
        if ok:
            self.current = profile
            self.error = ""
            self.message = f"Perfil aplicado: {label} ({profile})."
        else:
            self.error = detail

    def draw(self, stdscr: curses.window) -> None:
        stdscr.erase()
        height, width = stdscr.getmaxyx()
        safe_addstr(stdscr, 0, 2, APP_NAME, self.title_attr())
        safe_addstr(stdscr, 1, 2, f"Backend: {self.backend_label}", curses.A_DIM)
        safe_addstr(stdscr, 2, 2, "Selecciona el perfil de energía.", curses.A_DIM)

        y = 4
        for index, (label, profile) in enumerate(PROFILES):
            marker = ">" if self.selected == index else " "
            current = "*" if self.current == profile else " "
            text = f"{marker} {current} {label}   [{profile}]"
            attr = self.selected_attr() if self.selected == index else 0
            safe_addstr(stdscr, y, 2, text, attr)
            y += 1

        y += 1
        safe_addstr(stdscr, y, 2, "↑/↓ mover   Enter aplicar   q salir", curses.A_DIM)
        if self.error:
            y += 1
            safe_addstr(stdscr, y, 2, self.error, self.error_attr())
        elif self.message:
            y += 1
            safe_addstr(stdscr, y, 2, self.message)
        stdscr.refresh()

    def run(self, stdscr: curses.window) -> None:
        self.initialize_colors()
        curses.curs_set(0)
        stdscr.keypad(True)
        while True:
            self.draw(stdscr)
            key = stdscr.getch()
            if key in (ord("q"), 27):
                return
            if key in (curses.KEY_UP, ord("k")):
                self.selected = (self.selected - 1) % len(PROFILES)
            elif key in (curses.KEY_DOWN, ord("j")):
                self.selected = (self.selected + 1) % len(PROFILES)
            elif key in (10, 13, curses.KEY_ENTER):
                self.apply_selected(stdscr)
            elif key == curses.KEY_RESIZE:
                continue


def main() -> int:
    try:
        curses.wrapper(lambda stdscr: BatteryTUI().run(stdscr))
    except KeyboardInterrupt:
        return 130
    return 0


if __name__ == "__main__":
    sys.exit(main())
